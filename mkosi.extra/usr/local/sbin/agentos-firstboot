#!/bin/bash
# Apply /etc/agentos/agentos.env. Idempotent; runs every boot and after agentos-config changes.
set -euo pipefail
. /usr/local/lib/agentos/env.sh

install -d -m 711 /etc/agentos
[ -f "$AGENTOS_ENV" ] || install -m 600 /dev/null "$AGENTOS_ENV"
chmod 600 "$AGENTOS_ENV"

# 1. Hostname
h=$(env_get "$AGENTOS_ENV" AGENTOS_HOSTNAME)
[ -n "$h" ] && [ "$(hostname)" != "$h" ] && hostnamectl set-hostname "$h"

# 2. MCP bearer token (consumed by Plan 2)
if [ ! -s /etc/agentos/mcp-token ]; then
  (umask 077; head -c 32 /dev/urandom | od -An -tx1 | tr -d ' \n' > /etc/agentos/mcp-token)
fi

# 3. Secrets -> agent-owned file
install -d -o agent -g agent -m 700 /home/agent/.config /home/agent/.config/agentos
[ -f "$AGENTOS_SECRETS" ] || install -o agent -g agent -m 600 /dev/null "$AGENTOS_SECRETS"
while IFS= read -r line; do
  k=${line%%=*}; v=${line#*=}   # not IFS='=': read would drop a trailing "=" (base64 padding)
  is_secret_key "$k" || continue
  env_set "$AGENTOS_SECRETS" "$k" "$v"
  env_unset "$AGENTOS_ENV" "$k"
done < <(grep -E '^[A-Z0-9_]+=' "$AGENTOS_ENV" || true)
chown agent:agent "$AGENTOS_SECRETS"; chmod 600 "$AGENTOS_SECRETS"

# 4. Auto-reboot preference for unattended-upgrades
if [ "$(env_get "$AGENTOS_ENV" AGENTOS_AUTO_REBOOT)" = 0 ]; then
  echo 'Unattended-Upgrade::Automatic-Reboot "false";' > /etc/apt/apt.conf.d/53agentos-noreboot
else
  rm -f /etc/apt/apt.conf.d/53agentos-noreboot
fi

# 4b. Re-apply firewall (env may have changed)
/usr/local/sbin/agentos-firewall

# agentos.env is root-only, so publish the console mode to a world-readable file.
printf 'AGENTOS_CONSOLE=%s\n' "$(env_get "$AGENTOS_ENV" AGENTOS_CONSOLE | grep -x terminal || echo headless)" > /etc/agentos/console.mode
chmod 644 /etc/agentos/console.mode

# Desktop settings for agentos-computer (runs as agent; agentos.env is root-only). Invalid -> default.
md=$(env_get "$AGENTOS_ENV" AGENTOS_MAX_DESKTOPS | grep -xE '[1-9]|1[0-6]' || echo 8)
sw=$(env_get "$AGENTOS_ENV" AGENTOS_SCREENSHOT_WIDTH | grep -xE '6[4-9][0-9]|[7-9][0-9]{2}|1[0-8][0-9]{2}|19[01][0-9]|1920' || echo 1366)
# Idle desktop reaper (reap-desktops): minutes of no MCP/VNC-viewer activity before it stops a
# desktop; 0 disables it.
im=$(env_get "$AGENTOS_ENV" AGENTOS_DESKTOP_IDLE_MINUTES | grep -xE '0|[1-9][0-9]{0,5}' || echo 120)
printf 'MAX_DESKTOPS=%s\nSCREENSHOT_WIDTH=%s\nIDLE_MINUTES=%s\n' "$md" "$sw" "$im" > /etc/agentos/desktop.conf
chmod 644 /etc/agentos/desktop.conf

chmod 711 /etc/agentos

# 4d. Register the computer-use MCP server with the agent CLIs (warn only: never block boot on it).
# Bounded with timeout: a hung CLI (e.g. a network prompt) must not block console lockout prevention below.
timeout 120 runuser -u agent -- env -i HOME=/home/agent USER=agent \
  PATH=/home/agent/.local/bin:/home/agent/.cargo/bin:/home/agent/.bun/bin:/home/agent/.opencode/bin:/home/agent/.grok/bin:/usr/local/bin:/usr/bin:/bin \
  /usr/local/lib/agentos/register-mcp || echo "warning: agentos-computer MCP registration incomplete" >&2

# 5. Tailscale late: a bad key must not block the steps above. Failure -> unit fails, retried next boot.
# Auth key goes through a 0600 tempfile (tailscale's `--auth-key=file:...` form), never on the
# command line, so it can't leak via `ps` or process-list logging; the file is removed right after.
ts_rc=0
k=$(env_get "$AGENTOS_ENV" TS_AUTHKEY)
if [ -n "$k" ]; then
  kf=$(mktemp /run/agentos-tsauth.XXXXXX)
  trap 'rm -f "$kf"' EXIT
  printf '%s' "$k" > "$kf"
  if tailscale up --timeout=60s --auth-key="file:$kf" --hostname="$(hostname)" --ssh; then
    env_unset "$AGENTOS_ENV" TS_AUTHKEY
  else
    ts_rc=$?
  fi
  rm -f "$kf"
  trap - EXIT
fi

# 5b. Web UI settings for agentos-web (runs as agent; agentos.env is root-only). Invalid -> default.
wu=$(env_get "$AGENTOS_ENV" AGENTOS_WEB_USERS)
validate_setting AGENTOS_WEB_USERS "$wu" 2>/dev/null || wu=
we=$(env_get "$AGENTOS_ENV" AGENTOS_WEB | grep -x 0 || echo 1)
# Publish it on the tailnet (web-serve prints ok | off | tailscale-down | failed: <why>), then
# start or stop the unit. --no-block: agentos-web is ordered after this unit, so waiting would deadlock.
ws=$(/usr/local/lib/agentos/web-serve "$we")
printf 'USERS=%s\nENABLED=%s\nSERVE=%s\n' "$wu" "$we" "$ws" > /etc/agentos/web.conf.tmp
chmod 644 /etc/agentos/web.conf.tmp
mv /etc/agentos/web.conf.tmp /etc/agentos/web.conf
if [ "$we" = 1 ]; then
  systemctl enable --quiet agentos-web.service
  systemctl start --no-block agentos-web.service
else
  systemctl disable --quiet --now --no-block agentos-web.service
fi
# Say why on the console too: agetty prints /run/issue.d/*.issue after /etc/issue.
if [[ $ws == failed* ]]; then
  echo "warning: web UI: tailscale serve $ws" >&2   # to the journal (docs/tailscale-acl.md)
  install -d /run/issue.d
  printf 'Web UI: tailscale serve %s\n\n' "$ws" > /run/issue.d/50-agentos-web.issue
else
  rm -f /run/issue.d/50-agentos-web.issue
fi

# 5c. Solenta Mode A (AGENTOS_SOLENTA, default on): the .path unit starts agentos-solenta when
# Solenta's Remote Connections installs it; the service's condition keeps it inactive until then.
if [ "$(env_get "$AGENTOS_ENV" AGENTOS_SOLENTA | grep -x 0 || echo 1)" = 1 ]; then
  systemctl enable --quiet agentos-solenta.path agentos-solenta.service
  systemctl start --no-block agentos-solenta.path agentos-solenta.service
else
  systemctl disable --quiet --now --no-block agentos-solenta.path agentos-solenta.service
fi

# 6. Console lockout prevention last, so it sees Tailscale. It restarts getty@tty1, which is
# safe because this runs as its own unit (agentos-config apply restarts the unit).
/usr/local/sbin/agentos-console-apply
exit "$ts_rc"
