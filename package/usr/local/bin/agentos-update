#!/bin/bash
# Update AgentOS itself, the Debian packages, and every agent CLI/toolchain. Manual by design (never
# mid-task): the box checks daily and tells the owner, it never installs AgentOS on its own.
#   agentos-update                 as agent: the agentos package, then apt, then the CLIs and toolchains
#   agentos-update --check         refresh only the AgentOS source and write update.json (root, via sudo)
#   agentos-update --rollback [V]  as agent: list the AgentOS versions in the repo and install V
#                                  (default: the newest one older than the installed one)
#   agentos-update --version       print the installed AgentOS version
#   agentos-update --notice        print "AgentOS X available: ..." when update.json says so (MOTD)
#   agentos-update --issue         refresh the console notice in /run/issue.d from update.json (root)
set -euo pipefail
# Tests point AGENTOS_STATE (and the rest) at scratch paths and run unprivileged, without sudo.
STATE=${AGENTOS_STATE:-/var/lib/agentos}
SOURCES=${AGENTOS_SOURCES:-/etc/apt/sources.list.d/agentos.sources}
ISSUE=${AGENTOS_ISSUE:-/run/issue.d/60-agentos-update.issue}
LOCK=${AGENTOS_UPDATE_LOCK:-/run/lock/agentos-update.lock}
# check()'s own lock, for check-vs-check exclusion only: update()/rollback() hold BOTH this and
# $LOCK for their whole run, so a concurrent check still waits them out via this lock, but the web
# UI's "agentos-update is running" probe (which watches only $LOCK) never fires just because the
# daily check happens to be in progress.
CHECKLOCK=${AGENTOS_UPDATE_CHECK_LOCK:-/run/lock/agentos-update-check.lock}
ULOG=${AGENTOS_UPDATE_LOG:-/var/log/agentos-update.log}
VERSION_RE='^[0-9][A-Za-z0-9.+~]*$'
# Refresh only the AgentOS source: List-Cleanup=0 keeps the other sources' lists, and --error-on=any
# makes a bad signature or an unreachable repo an error (plain apt-get update exits 0 on both and
# keeps the old lists).
APT_AGENTOS="-o Dir::Etc::sourcelist=$(printf %q "$SOURCES") -o Dir::Etc::sourceparts=- -o APT::Get::List-Cleanup=0"
# A locally edited conffile is kept (the new one is saved as .dpkg-dist): an update never prompts.
APT_CONF="-o Dpkg::Options::=--force-confdef -o Dpkg::Options::=--force-confold -o DPkg::Lock::Timeout=300"

installed() { dpkg-query -W -f '${Version}' agentos 2>/dev/null || true; }
as_root() { [ "$(id -u)" = 0 ] || [ -n "${AGENTOS_STATE:-}" ] || exec sudo -n "$0" "$@"; }
source_problem() {  # why the AgentOS source can't be used, or nothing
  if [ ! -f "$SOURCES" ]; then echo "no AgentOS update source ($SOURCES is missing)"
  elif grep -qiE '^Enabled:[[:space:]]*no[[:space:]]*$' "$SOURCES"; then echo "the AgentOS update source is disabled (development build)"
  fi
}
notice() {
  local a
  a=$(jq -r '.available // empty' "$STATE/update.json" 2>/dev/null) || return 0
  if [[ $a =~ $VERSION_RE ]]; then printf 'AgentOS %s available: run agentos-update (or use the web UI)\n' "$a"; fi
}
write_issue() {  # agetty shows /run/issue.d/*.issue after /etc/issue (the version can't hold a "\")
  local n; n=$(notice)
  if [ -n "$n" ]; then install -d "$(dirname "$ISSUE")"; printf '%s\n\n' "$n" > "$ISSUE"; else rm -f "$ISSUE"; fi
}

check() {
  local inst cand avail="" err out base notes="" tmp st
  exec 9<"$CHECKLOCK"
  # -w 10, not -n: another check (the daily timer racing a web UI "Check now", or finish()'s own
  # refresh) only ever holds this briefly, and a losing race there must not skip silently. A real
  # update/rollback holds this lock too (for its whole run), so a check started while one is in
  # progress still waits here -- it just doesn't make the web UI's "running" probe fire, since that
  # probe watches $LOCK, not this one.
  flock -w 10 9 || { echo "agentos-update is running; check skipped" >&2; return 0; }
  inst=$(installed)
  err=$(source_problem)
  if [ -z "$err" ]; then
    if [ -z "$inst" ]; then
      err="the agentos package is not installed"
    else
      # A migration that failed mid-update leaves dpkg's status anything but "ii " (fully
      # installed, configured, no error) even though ${Version} already reports the new version:
      # installed() alone would read that as "up to date".
      st=$(dpkg-query -W -f '${db:Status-Abbrev}' agentos 2>/dev/null || true)
      [ "$st" = "ii " ] || err="agentos is not fully configured (a migration failed): run agentos-update"
    fi
  fi
  if [ -z "$err" ]; then
    # shellcheck disable=SC2086 # APT_AGENTOS is a list of words
    if out=$(apt-get update -qq --error-on=any $APT_AGENTOS 2>&1); then
      cand=$(apt-cache policy agentos | sed -n 's/^ *Candidate: //p')
      if [ "$cand" = "(none)" ]; then
        err="agentos is not in the AgentOS repository index"
      elif [[ ! $cand =~ $VERSION_RE ]]; then
        err="the repo offers an invalid version"
      elif dpkg --compare-versions "$cand" gt "$inst"; then
        avail=$cand
      fi
    else
      err=$(printf '%s\n' "$out" | sed -n 's/^E: //p' | head -1 | cut -c1-300)
      err=${err:-apt-get update failed}
    fi
  fi
  base=$(sed -n 's/^URIs:[[:space:]]*//p' "$SOURCES" 2>/dev/null | head -1); base=${base%/}
  # The notes are untrusted text: at most 4 KB, shown as plain text by the web UI and the console.
  # pipefail is off for this one pipeline: once `head` has its 4 KB it stops reading, curl gets
  # SIGPIPE/EPIPE on its next write and the pipeline's exit status would otherwise be non-zero,
  # which fed into `|| notes=` and threw away the 4 KB `head` had already captured.
  if [ -n "$avail" ]; then
    notes=$(set +o pipefail; curl -fsS --max-time 20 --max-filesize 65536 "$base/notes/$avail.md" 2>/dev/null | head -c 4096) || notes=
    # Strip control bytes (keep \n and \t) once, before notes are stored or printed: they're
    # untrusted text shown as-is by the web UI and the console. tr handles the single-byte C0
    # controls and DEL; the C1 controls (U+0080-U+009F) are two UTF-8 bytes (\xC2\x80-\xC2\x9F) and
    # a byte-range tr/sed over \x80-\x9F would also mangle the continuation bytes of ordinary
    # multi-byte UTF-8 text (e.g. \xC3\xA9 "e"), so they're matched as that exact two-byte sequence,
    # in LC_ALL=C so sed compares raw bytes rather than decoding (possibly invalid) UTF-8.
    notes=$(printf '%s' "$notes" | LC_ALL=C tr -d '\000-\010\013-\037\177' | LC_ALL=C sed 's/\xc2[\x80-\x9f]//g')
  fi
  tmp=$(mktemp "$STATE/.update.json.XXXXXX")
  # $tmp is set with its final value now, not re-read when the trap fires: a `local` var set -e
  # unwinds out of scope by the time an EXIT trap runs, after the function that declared it returns.
  # shellcheck disable=SC2064 # intentional: see above
  trap "rm -f $(printf %q "$tmp")" EXIT
  jq -n --arg i "$inst" --arg a "$avail" --arg u "${avail:+$base/notes/$avail.md}" --arg n "$notes" \
    --arg t "$(date -u +%Y-%m-%dT%H:%M:%SZ)" --arg e "$err" \
    'def opt: if . == "" then null else . end;
     {installed: ($i | opt), available: ($a | opt), notes_url: ($u | opt), notes: $n, checked_at: $t, error: ($e | opt)}' > "$tmp"
  chmod 644 "$tmp"
  mv "$tmp" "$STATE/update.json"
  trap - EXIT
  write_issue
  if [ -n "$err" ]; then echo "AgentOS update check failed: $err"
  elif [ -n "$avail" ]; then echo "AgentOS $avail is available (installed: $inst)"; [ -z "$notes" ] || printf '\n%s\n' "$notes"
  else echo "AgentOS $inst is up to date"; fi
}

FAILED=0
say() {  # to the update log, and to stdout while anyone still reads it
  printf '%s\n' "$*" >> "$ULOG"
  printf '%s\n' "$*" 2>/dev/null || true
}
step() {  # step <label> <command...>
  local label=$1 l; shift
  # begin() ignores SIGPIPE for this script (see there), but a step's own pipes (grok's installer
  # piped into bash, apt/dpkg scriptlets, ...) expect the normal default: terminate on SIGPIPE.
  # env --default-signal resets that before exec, and it survives through sudo/bash to anything
  # the step runs.
  if env --default-signal=PIPE "$@" >"$LOG" 2>&1; then say "ok    $label"
  else say "FAIL  $label (see below)"; while IFS= read -r l; do say "      $l"; done < <(tail -5 "$LOG"); FAILED=1; fi
}
begin() {  # lock (both: this run's own, and the one a concurrent check waits on), then log
  [ "$(id -un)" = agent ] || { echo "run as the agent user" >&2; exit 2; }
  exec 9<"$LOCK"
  exec 8<"$CHECKLOCK"
  # Either lock only ever briefly held by something else (another update/rollback finishing up, or
  # a check): wait for it rather than giving up immediately.
  flock -w 60 9 || { echo "agentos-update is already running" >&2; exit 3; }
  flock -w 60 8 || { flock -u 9; echo "an update check is running, try again shortly" >&2; exit 3; }
  # Started from the web UI, this process outlives agentos-web's restart (KillMode=process), but its
  # stdout then has no reader: ignore SIGPIPE and keep going; the web UI reads $ULOG instead.
  trap '' PIPE
  : > "$ULOG"
  LOG=$(mktemp /tmp/agentos-update.XXXXXX.log)
  trap 'rm -f "$LOG"' EXIT
  say "== agentos-update $* $(date -u +%Y-%m-%dT%H:%M:%SZ)"
}
finish() {  # refresh update.json (and the console/MOTD notice), report, unlock both
  # Release only the check-lock before the self-check: it only ever takes that lock (see check()),
  # so releasing it here can't deadlock against it, and a concurrent check() is freed to run
  # immediately instead of waiting out our own self-check too. The update-lock stays held until
  # "== done" is actually written, so the web UI's "running" probe (which watches only that lock)
  # keeps reporting this run as running for its entire duration, including the self-check.
  flock -u 8
  sudo -n "$0" --check >/dev/null 2>&1 || true
  say "== done: $([ "$FAILED" = 0 ] && echo ok || echo 'with failures')"
  flock -u 9
  exit "$FAILED"
}

update() {
  local why ids
  begin
  # shellcheck source=/dev/null
  . /etc/profile.d/agentos.sh
  ids=$(agentos-ci list --json --limit 200 2>/dev/null | jq -r '[.[] | select(.status == "running" or .status == "queued") | .id] | join(" ")' 2>/dev/null) || ids=
  [ -z "$ids" ] || say "warning: CI runs in progress: $ids (they keep running; agentos-web restarts during the update)"
  why=$(source_problem)
  if [ -n "$why" ]; then say "skip  agentos ($why)"
  # dpkg --configure -a first: a package stuck half-configured by an earlier failed migration is
  # already at its target version, so "--only-upgrade" alone could see nothing to upgrade and
  # never touch it. Not "&&"-chained: an update() run must still attempt the rest even if this has
  # nothing to do (exit 1) or the earlier failure needs the apt step below to actually fix it.
  else step "agentos" sudo bash -c "export DEBIAN_FRONTEND=noninteractive; dpkg --configure -a; apt-get update -qq --error-on=any $APT_AGENTOS && apt-get -y -qq $APT_CONF install --only-upgrade agentos"
  fi
  step "apt"      sudo bash -c "export DEBIAN_FRONTEND=noninteractive; apt-get update -qq && apt-get -y -qq $APT_CONF full-upgrade"
  step "claude"   claude update
  step "codex"    npm install -g @openai/codex@latest
  step "opencode" opencode upgrade
  step "grok"     bash -c 'set -o pipefail; grok update 2>/dev/null || curl -fsSL https://x.ai/cli/install.sh | bash'
  step "rustup"   rustup update
  step "bun"      bun upgrade
  step "playwright" bash -c 'npm install -g playwright@latest && playwright install chromium'
  finish
}

rollback() {
  local why inst target v vers=()
  begin --rollback "$@"
  why=$(source_problem)
  [ -z "$why" ] || { say "FAIL  rollback ($why)"; FAILED=1; finish; }
  # shellcheck disable=SC2086,SC2024 # APT_AGENTOS is a list of words; $LOG is agent's own file
  if ! sudo apt-get update -qq --error-on=any $APT_AGENTOS >"$LOG" 2>&1; then
    say "FAIL  rollback (the AgentOS repo could not be read)"; while IFS= read -r v; do say "      $v"; done < <(tail -5 "$LOG"); FAILED=1; finish
  fi
  inst=$(installed)
  mapfile -t vers < <(apt-cache madison agentos | awk -F'|' '{gsub(/ /, "", $2); print $2}')   # newest first
  say "AgentOS versions in the repo (installed: ${inst:-none}):"
  for v in "${vers[@]}"; do say "  $v"; done
  target=${1:-}
  if [ -z "$target" ]; then
    for v in "${vers[@]}"; do if dpkg --compare-versions "$v" lt "$inst"; then target=$v; break; fi; done
    [ -n "$target" ] || { say "FAIL  rollback (no version older than $inst in the repo)"; FAILED=1; finish; }
  fi
  printf '%s\n' "${vers[@]}" | grep -qxF -- "$target" || { say "FAIL  rollback ($target is not in the repo)"; FAILED=1; finish; }
  # Migrations are forward-only and safe to run again: a rollback does not undo them.
  step "agentos $target" sudo bash -c "export DEBIAN_FRONTEND=noninteractive; apt-get -y -qq --allow-downgrades $APT_CONF install agentos=$(printf %q "$target")"
  finish
}

case "${1:-}" in
  "")         update ;;
  --check)    as_root "$@"; check ;;
  --rollback) shift; rollback "$@" ;;
  --version)  v=$(installed); [ -n "$v" ] || { echo "agentos is not installed" >&2; exit 1; }; echo "$v" ;;
  --notice)   notice ;;
  --issue)    as_root "$@"; write_issue ;;
  *)          sed -n '4,10s/^# \{0,1\}//p' "$0" >&2; exit 2 ;;
esac
