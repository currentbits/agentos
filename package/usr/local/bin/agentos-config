#!/bin/bash
# AgentOS configuration: whiptail menu (no args) or scriptable subcommands.
set -euo pipefail
[ "$(id -u)" = 0 ] || exec sudo "$0" "$@"
. /usr/local/lib/agentos/env.sh

AK=/home/agent/.ssh/authorized_keys
WEB_CONF=${WEB_CONF:-/etc/agentos/web.conf}   # test hook

# A password change must drop any live LAN web UI sessions (lan.ts keeps them only in memory, keyed
# off the old password's success): the simplest way to end them is to restart the service. A no-op
# when LAN access is off, or the restart itself fails (the new password is still set either way).
restart_web_for_password_change() {
  if grep -qx LAN=1 "$WEB_CONF" 2>/dev/null; then systemctl restart agentos-web.service || true; fi
}

# VALUE "-" means "read it from stdin": the web UI passes values that way because sudo logs its
# argv to the journal, and a secret must never land there. An empty secret value clears it.
cmd_set() {
  local v=$2
  if [ "$v" = - ]; then IFS= read -r v || true; fi
  validate_setting "$1" "$v" || exit 2
  if is_secret_key "$1"; then
    install -d -o agent -g agent -m 700 /home/agent/.config/agentos
    if [ -n "$v" ]; then env_set "$AGENTOS_SECRETS" "$1" "$v"; else env_unset "$AGENTOS_SECRETS" "$1"; fi
    if [ -f "$AGENTOS_SECRETS" ]; then chown agent:agent "$AGENTOS_SECRETS"; chmod 600 "$AGENTOS_SECRETS"; fi
  else
    env_set "$AGENTOS_ENV" "$1" "$v"
  fi
}
cmd_get() {
  is_secret_key "$1" && { echo "refusing to print secret $1" >&2; exit 3; }
  env_get "$AGENTOS_ENV" "$1"
}
cmd_add_ssh_key() {
  [[ $1 != *$'\n'* && $1 != *$'\r'* ]] || { echo "SSH key must be a single line" >&2; exit 2; }
  [[ $1 =~ ^(ssh-(ed25519|rsa)|ecdsa-sha2-nistp(256|384|521)|sk-(ssh-ed25519|ecdsa-sha2-nistp256)@openssh\.com)\ [A-Za-z0-9+/=]+(\ [^[:cntrl:]]*)?$ ]] \
    || { echo "not an SSH public key" >&2; exit 2; }
  install -d -o agent -g agent -m 700 /home/agent/.ssh
  touch "$AK"; grep -qxF "$1" "$AK" || printf '%s\n' "$1" >> "$AK"
  chown agent:agent "$AK"; chmod 600 "$AK"
}
# Remove every authorized_keys line whose key has this fingerprint (as `ssh-keygen -l` prints it).
cmd_remove_ssh_key() {
  [[ $1 =~ ^SHA256:[A-Za-z0-9+/]{43}$ ]] || { echo "not a SHA256 key fingerprint: $1" >&2; exit 2; }
  local tmp line fp found=0
  tmp=$(mktemp "$AK.XXXXXX")
  while IFS= read -r line || [ -n "$line" ]; do
    fp=$(ssh-keygen -l -f - <<< "$line" 2>/dev/null | awk '{print $2}') || true
    if [ "$fp" = "$1" ]; then found=1; else printf '%s\n' "$line" >> "$tmp"; fi
  done < <(cat "$AK" 2>/dev/null)
  if [ "$found" = 0 ]; then rm -f "$tmp"; echo "no SSH key with fingerprint $1" >&2; exit 1; fi
  chown agent:agent "$tmp"; chmod 600 "$tmp"; mv "$tmp" "$AK"
}
cmd_github_keys() {
  [[ $1 =~ ^[A-Za-z0-9-]{1,39}$ ]] || { echo "invalid GitHub username" >&2; exit 2; }
  local keys; keys=$(curl -fsS --max-time 15 "https://github.com/$1.keys")
  [ -n "$keys" ] || { echo "no public keys for GitHub user $1" >&2; exit 1; }
  while IFS= read -r k; do cmd_add_ssh_key "$k"; done <<< "$keys"
}
# Solenta pairing (the same facts as the web UI's Solenta card), computed as agent by solenta-pair.
cmd_solenta() {
  local out
  out=$(runuser -u agent -- env -i HOME=/home/agent PATH=/usr/local/bin:/usr/bin:/bin \
          /usr/local/lib/agentos/solenta-pair status ${1:+-- "$1"}) || exit 1
  # shellcheck disable=SC2016 # jq program, not shell
  jq -r '
    "Solenta and \(.host)",
    "",
    "Mode A (recommended): in Solenta, Settings > Connections > Remote Connections, add \(.remoteHost).",
    "  agentos-solenta: \(.modeA.service) (\(if .modeA.enabled then "enabled" else "disabled: AGENTOS_SOLENTA=0" end)), Solenta \(.modeA.version // "not installed yet"), web token \(if .modeA.webToken then "present" else "absent" end)",
    "",
    "1. SSH access: " + (if .tailscaleSsh then "Tailscale SSH is on; your tailnet policy decides who may connect."
                         else "add the Mac'"'"'s public key: sudo agentos-config add-ssh-key \"ssh-ed25519 AAAA... you@mac\"" end),
    "   Host key fingerprints: compare them with what ssh shows on the Mac, then add the key there:",
    (.hostKeys[] | "     \(.type) \(.fingerprint)"),
    "     \(.keyscan)",
    "2. Repo: sudo agentos-config solenta clone <git URL> <name>, or use any checkout under /home/agent.",
    "3. Mode B values for the Solenta project: remoteHost = \(.remoteHost), remotePath = \(.remotePath // "/home/agent/work/<name>")",
    "4. Preflight (as Solenta runs commands: non-login, non-interactive):",
    (.preflight[] | "   \(if .ok then "PASS" else "FAIL" end)  \(.item): \(.detail)")' <<< "$out"
}

# Run as its own unit: firstboot ends with agentos-console-apply, which restarts getty@tty1 and
# would kill a menu running there (agentos-config-tty) if firstboot ran inside it.
# LAN access to the web UI needs a password for agent: firstboot (web-conf) leaves it off without
# one, and apply says so, last on stderr (the web UI's Settings page shows that line).
cmd_apply() {
  local rc=0
  systemctl restart agentos-firstboot.service || rc=$?
  if [ "$(env_get "$AGENTOS_ENV" AGENTOS_WEB_LAN)" = 1 ] && ! agent_has_password; then
    echo "LAN access to the web UI is not on: set a password for agent first (sudo agentos-config password), then apply again" >&2
    rc=3
  fi
  return "$rc"
}
cmd_show_web_fingerprint() {
  local fp; fp=$(sed -n 's/^FINGERPRINT=//p' /etc/agentos/web.conf 2>/dev/null)
  [ -n "$fp" ] || { echo "LAN access to the web UI is off: sudo agentos-config set AGENTOS_WEB_LAN 1 && sudo agentos-config apply" >&2; return 1; }
  printf '%s\n' "$fp"
}

# cmd_set exits on an invalid value: run it in a subshell so the menu survives and says why.
menu_set() { local err; err=$( (cmd_set "$1" "$2") 2>&1) || whiptail --msgbox "$1 not saved: $err" 10 72; }

menu() {
  while true; do
    local c
    # shellcheck disable=SC1010 # "done" below is a whiptail menu tag, not the loop keyword
    c=$(whiptail --title "AgentOS configuration" --menu "Choose a setting" 24 72 14 \
      password  "Set password for 'agent' (console + sudo)" \
      sshkey    "Add an SSH public key" \
      github    "Import SSH keys from a GitHub username" \
      tailscale "Tailscale auth key" \
      apikeys   "API keys / OAuth token" \
      lanssh    "Allow SSH from LAN (no Tailscale)" \
      console   "Local console: headless or terminal" \
      desktops  "Desktops: max count and screenshot width" \
      reboot    "Auto-reboot for kernel security updates" \
      webui     "Web UI: tailnet logins allowed to use it" \
      weblan    "Web UI on the local network (password login)" \
      webfp     "Show the web UI's LAN certificate fingerprint" \
      mcptoken  "Show MCP HTTP bearer token" \
      solenta   "Solenta: pairing values and preflight" \
      done      "Apply and exit" 3>&1 1>&2 2>&3) || c=done
    case $c in
      password)  passwd agent && restart_web_for_password_change || true ;;
      # cmd_* use `exit` on bad input: run them in a subshell so a failure returns to the menu.
      sshkey)    if k=$(whiptail --inputbox "Paste SSH public key" 10 72 3>&1 1>&2 2>&3); then
                   err=$( (cmd_add_ssh_key "$k") 2>&1) || whiptail --msgbox "SSH key not added: $err" 10 72
                 fi ;;
      github)    if u=$(whiptail --inputbox "GitHub username" 10 60 3>&1 1>&2 2>&3); then
                   err=$( (cmd_github_keys "$u") 2>&1) || whiptail --msgbox "GitHub keys not imported: $err" 10 72
                 fi ;;
      tailscale) whiptail --msgbox "Use a SINGLE-USE, pre-approved auth key tagged tag:agentos.\n\nTagged: this machine cannot reach your other devices. Single-use: the key may stay readable afterwards (e.g. in cloud user-data), so it must be worthless once used. See docs/tailscale-acl.md." 14 72
                 k=$(whiptail --passwordbox "Tailscale auth key (tskey-auth-...)" 10 72 3>&1 1>&2 2>&3) && [ -n "$k" ] && cmd_set TS_AUTHKEY "$k" || true ;;
      apikeys)   whiptail --msgbox "Use a dedicated, spend-capped key per AgentOS machine: a hijacked agent can read any key stored here." 10 72
                 for n in ANTHROPIC_API_KEY OPENAI_API_KEY XAI_API_KEY CLAUDE_CODE_OAUTH_TOKEN; do
                   v=$(whiptail --passwordbox "$n (empty = keep current)" 10 72 3>&1 1>&2 2>&3) || break
                   [ -n "$v" ] && cmd_set "$n" "$v"
                 done ;;
      lanssh)    if whiptail --yesno "Open SSH (key-only) on all interfaces?" 8 60; then cmd_set AGENTOS_LAN_SSH 1; else cmd_set AGENTOS_LAN_SSH 0; fi ;;
      console)   m=$(whiptail --menu "Local console mode" 12 60 2 headless "Status + login prompt" terminal "Full-screen terminal after login" 3>&1 1>&2 2>&3) && cmd_set AGENTOS_CONSOLE "$m" || true ;;
      desktops)  m=$(whiptail --inputbox "Max concurrent desktops (1-16)" 10 60 "$(cmd_get AGENTOS_MAX_DESKTOPS || true)" 3>&1 1>&2 2>&3) && [ -n "$m" ] && menu_set AGENTOS_MAX_DESKTOPS "$m" || true
                 w=$(whiptail --inputbox "Screenshot width in px (640-1920, default 1366)" 10 60 "$(cmd_get AGENTOS_SCREENSHOT_WIDTH || true)" 3>&1 1>&2 2>&3) && [ -n "$w" ] && menu_set AGENTOS_SCREENSHOT_WIDTH "$w" || true
                 i=$(whiptail --inputbox "Stop an idle, unwatched desktop after this many minutes (0 = never, default 120)" 10 60 "$(cmd_get AGENTOS_DESKTOP_IDLE_MINUTES || true)" 3>&1 1>&2 2>&3) && [ -n "$i" ] && menu_set AGENTOS_DESKTOP_IDLE_MINUTES "$i" || true ;;
      reboot)    if whiptail --yesno "Reboot automatically at 04:00 when a kernel update requires it?" 8 70; then cmd_set AGENTOS_AUTO_REBOOT 1; else cmd_set AGENTOS_AUTO_REBOOT 0; fi ;;
      webui)     u=$(whiptail --inputbox "Tailnet logins allowed to use the web UI, comma-separated (you@example.com). Empty = nobody." 10 72 "$(cmd_get AGENTOS_WEB_USERS || true)" 3>&1 1>&2 2>&3) && menu_set AGENTOS_WEB_USERS "$u" || true ;;
      weblan)    if whiptail --defaultno --yesno "Allow the web UI on your local network, at https://<this machine's address>, with the password of 'agent'?\n\nAnyone on your network who knows that password gets full control of this machine. Tailscale is safer." 12 74; then
                   agent_has_password || { whiptail --msgbox "LAN access needs a password for 'agent'. Set one now." 8 60; passwd agent || true; }
                   cmd_set AGENTOS_WEB_LAN 1
                 else cmd_set AGENTOS_WEB_LAN 0; fi ;;
      webfp)     whiptail --msgbox "$(fp=$(cmd_show_web_fingerprint 2>&1) && printf 'Compare this with the certificate your browser shows for https://<this machine>:\n\n%s' "$fp" || printf '%s' "$fp")" 12 76 ;;
      solenta)   whiptail --scrolltext --title Solenta --msgbox "$(cmd_solenta 2>&1)" 24 76 ;;
      mcptoken)  whiptail --msgbox "$(cat /etc/agentos/mcp-token)\n\nThis token (and any view_url built from it) gives full control of the desktops: treat it like a root password." 11 72 ;;
      done)      cmd_apply || whiptail --msgbox "Some settings failed to apply (see: journalctl -u agentos-firstboot). Tailscale key wrong?" 9 72
                 return ;;
    esac
  done
}

case "${1:-}" in
  "")              menu ;;
  set)             [ $# -eq 3 ] || { echo "usage: agentos-config set KEY VALUE" >&2; exit 2; }; cmd_set "$2" "$3" ;;
  get)             [ $# -eq 2 ] || { echo "usage: agentos-config get KEY" >&2; exit 2; }; cmd_get "$2" ;;
  add-ssh-key)     k=${2:?usage: agentos-config add-ssh-key KEY (or - to read it from stdin)}
                   if [ "$k" = - ]; then IFS= read -r k || true; fi
                   cmd_add_ssh_key "$k" ;;
  remove-ssh-key)  cmd_remove_ssh_key "${2:?usage: agentos-config remove-ssh-key SHA256:...}" ;;
  github-keys)     cmd_github_keys "${2:?usage: agentos-config github-keys <user>}" ;;
  password)        passwd agent && restart_web_for_password_change ;;
  apply)           cmd_apply ;;
  show-mcp-token)  cat /etc/agentos/mcp-token ;;
  show-web-fingerprint) cmd_show_web_fingerprint ;;
  solenta)         if [ "${2:-}" = clone ]; then
                     [ $# -eq 4 ] || { echo "usage: agentos-config solenta clone URL NAME" >&2; exit 2; }
                     runuser -u agent -- env -i HOME=/home/agent PATH=/usr/local/bin:/usr/bin:/bin \
                       /usr/local/lib/agentos/solenta-pair clone "$3" "$4"
                   else
                     [ $# -le 2 ] || { echo "usage: agentos-config solenta [PATH]" >&2; exit 2; }
                     cmd_solenta "${2:-}"
                   fi ;;
  *)               echo "usage: agentos-config [set KEY VALUE|-|get KEY|add-ssh-key KEY|-|remove-ssh-key FINGERPRINT|github-keys USER|password|apply|show-mcp-token|show-web-fingerprint|solenta [PATH]|solenta clone URL NAME]" >&2; exit 2 ;;
esac
