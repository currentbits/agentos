[Unit]
Description=Partitioned loop device for the AgentOS installer CD /dev/%I
DefaultDependencies=no
# Only on a CD boot: GRUB adds agentos.cd (installer/mkosi.postoutput); USB boots are unchanged.
ConditionKernelCommandLine=agentos.cd
Before=initrd-root-device.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/sh -c 'modprobe -q loop; losetup -j /dev/%I | grep -q . || losetup -f -P -r -b 512 /dev/%I'
