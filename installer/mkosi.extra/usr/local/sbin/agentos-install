#!/bin/bash
# AgentOS installer: writes the tested AgentOS disk image to a whole disk and applies settings.
#   agentos-install --auto        unattended if configured (kernel cmdline URL or AGENTOS partition), else READY
#   agentos-install --tui         interactive (whiptail) installer; runs on tty1
#   agentos-install --env FILE    install using KEY=VALUE settings from FILE
set -Eeuo pipefail  # -E: the ERR trap set in install_from_env also fires in functions and subshells
. /usr/lib/agentos-installer/lib.sh
IMG_DIR=/usr/share/agentos
IMG=$IMG_DIR/agentos.raw.zst
DATA_DEV=/dev/disk/by-partlabel/AGENTOS
TARGET=/mnt/target
TARGET_ESP=/mnt/target-esp
ESP_PARTTYPE=c12a7328-f81f-11d2-ba4b-00a0c93ec93b
LOG=/tmp/agentos-install.log

# ERASED is set once writing starts, so every later failure says the disk was erased.
die() { echo "INSTALL FAILED: $*${ERASED:+ ($ERASED was erased; fix the problem and run the installer again)}" >&2; exit 1; }

boot_disk() { lsblk -no PKNAME "$(findmnt -no SOURCE /)" | head -1; }

check_disk() {
  local d=$1 real b
  [ -b "$d" ] || die "$d is not a block device"
  real=$(readlink -f "$d")
  [ "$(lsblk -dno TYPE "$real")" = disk ] || die "$d is not a whole disk"
  b=$(boot_disk) || b=""
  [ -n "$b" ] || die "cannot determine the installer's own disk; refusing to continue"
  [ "$(basename "$real")" != "$b" ] || die "refusing to install onto the installer's own disk ($d)"
  if [ -e "$DATA_DEV" ]; then  # the stick holding agentos.env, even if the installer runs from elsewhere
    b=$(lsblk -no PKNAME "$(readlink -f "$DATA_DEV")" | head -1) || b=""
    [ -n "$b" ] || die "cannot determine the disk of the AGENTOS partition; refusing to continue"
    [ "$(basename "$real")" != "$b" ] || die "refusing to install onto the installer's own disk ($d holds the AGENTOS partition)"
  fi
  ! disk_in_use "/sys/class/block/$(basename "$real")" || die "$d is in use (LVM/RAID/dm)"
  [ "$(lsblk -bdno SIZE "$real")" -ge "$MIN_DISK_BYTES" ] || die "$d is smaller than 32 GiB"
  # agentos.raw is a 512-byte-sector GPT image: on a 4Kn disk its partition table would be unreadable.
  b=$(lsblk -dno LOG-SEC "$real" | tr -d ' ') || b=""
  [ "$b" = 512 ] || die "$d has $b-byte logical sectors (4K-native); not supported. The disk was not touched."
  ! lsblk -no MOUNTPOINTS "$real" | grep -q . || die "$d has mounted partitions"
}

cleanup_mounts() {
  local m
  for m in "$TARGET_ESP" "$TARGET/proc" "$TARGET/dev" "$TARGET"; do mountpoint -q "$m" && umount "$m" || true; done
  return 0
}

install_from_env() {
  local parsed disk real root esp old new p line k v ghkeys=""
  parsed=$(parse_env "$1") || die "invalid settings file $1"
  get() { printf '%s\n' "$parsed" | env_value "$1"; }

  # --- validate everything before touching any disk ---
  disk=$(get AGENTOS_INSTALL_DISK); [ -n "$disk" ] || die "AGENTOS_INSTALL_DISK is not set"
  check_disk "$disk"; real=$(readlink -f "$disk")
  v=$(get AGENTOS_HOSTNAME);      [ -z "$v" ] || valid_hostname "$v"      || die "invalid AGENTOS_HOSTNAME"
  v=$(get AGENTOS_SSH_KEY);       [ -z "$v" ] || valid_ssh_pubkey "$v"    || die "invalid AGENTOS_SSH_KEY"
  v=$(get AGENTOS_PASSWORD_HASH); [ -z "$v" ] || valid_password_hash "$v" || die "AGENTOS_PASSWORD_HASH must be a \$6\$ or \$y\$ crypt hash (openssl passwd -6)"
  if [ -n "$(get AGENTOS_NET_ADDRESS)" ]; then
    valid_iface "$(get AGENTOS_NET_IFACE)" && valid_cidr "$(get AGENTOS_NET_ADDRESS)" &&
      valid_ipv4 "$(get AGENTOS_NET_GATEWAY)" || die "invalid static network settings (AGENTOS_NET_*)"
    for v in $(get AGENTOS_NET_DNS | tr ',' ' '); do valid_ipv4 "$v" || die "invalid DNS server $v"; done
  fi
  v=$(get AGENTOS_GITHUB_USER)
  if [ -n "$v" ]; then
    [[ $v =~ ^[A-Za-z0-9-]{1,39}$ ]] || die "invalid AGENTOS_GITHUB_USER"
    ghkeys=$(curl -fsS --max-time 20 "https://github.com/$v.keys") || die "could not fetch SSH keys for GitHub user $v"
  fi
  echo "Verifying the AgentOS image on this stick..."
  (cd "$IMG_DIR" && sha256sum -c --quiet agentos.raw.zst.sha256) || die "the installer image is corrupt; re-flash the stick. Nothing was changed."

  # --- write ---
  echo "Writing AgentOS to $disk. Everything on it will be erased."
  ERASED=$disk
  # From here the ERR trap fires inside $(...) too: add no substitutions whose failure is expected (or guard them with ||).
  trap 'die "unexpected error at line $LINENO"' ERR
  # Partition signatures first: the whole-disk wipefs only clears the disk's own (GPT/MBR) ones.
  for p in $(lsblk -lnpo NAME,TYPE "$real" | awk '$2=="part"{print $1}'); do wipefs -a "$p" >/dev/null; done
  wipefs -a "$real" >/dev/null
  # status=progress floods kmsg in --auto mode (carriage-return updates); the TUI sets AGENTOS_DD_STATUS=progress.
  zstd -dc "$IMG" | dd of="$real" bs=4M conv=fsync status="${AGENTOS_DD_STATUS:-none}" ||
    die "writing the image failed"
  sgdisk -e "$real" >/dev/null || die "could not move the backup GPT to the end of $disk"
  partx -u "$real" 2>/dev/null || true
  udevadm settle || true  # a slow device is handled by the retry loop below, not the ERR trap
  root=""
  for _ in $(seq 1 20); do
    root=$(lsblk -lnpo NAME,PARTLABEL "$real" | awk -v l="$ROOT_PARTLABEL" '$2==l{print $1}')
    [ -n "$root" ] && break
    sleep 0.5; udevadm settle || true
  done
  [ -n "$root" ] || die "root partition not found on $disk after writing"

  # --- per-install identity: every install from the same image would share its disk/partition GUIDs ---
  old=$(blkid -p -s PART_ENTRY_UUID -o value "$root") || die "could not read the root PARTUUID"
  sgdisk -G "$real" >/dev/null || die "could not give $disk new GUIDs"
  partx -u "$real" 2>/dev/null || true
  udevadm settle || true
  new=$(blkid -p -s PART_ENTRY_UUID -o value "$root") || die "could not read the new root PARTUUID"
  [ -n "$new" ] && [ "$new" != "$old" ] || die "the root PARTUUID did not change"
  esp=$(lsblk -lnpo NAME,PARTTYPE "$real" | awk -v t="$ESP_PARTTYPE" '$2==t{print $1}')
  [ -n "$esp" ] && [ "$(wc -l <<< "$esp")" = 1 ] || die "ESP not found on $disk"
  trap cleanup_mounts EXIT
  mkdir -p "$TARGET_ESP"; mount "$esp" "$TARGET_ESP"
  rewrite_root_partuuid "$TARGET_ESP" "$old" "$new" || die "could not update root=PARTUUID in the boot config"
  umount "$TARGET_ESP"

  # --- configure the new system via its own agentos-config ---
  mkdir -p "$TARGET"; mount "$root" "$TARGET"
  fstab_root_partuuid "$TARGET/etc/fstab" "$new" || die "could not update the root entry in /etc/fstab"
  mount --bind /dev "$TARGET/dev"; mount -t proc proc "$TARGET/proc"
  install -d -m 711 "$TARGET/etc/agentos"  # normally created by agentos-firstboot; agentos-config set needs it now
  while IFS= read -r line; do
    k=${line%%=*}; v=${line#*=}
    is_installer_key "$k" && continue
    [ -n "$v" ] || continue
    chroot "$TARGET" /usr/local/bin/agentos-config set "$k" "$v" >/dev/null || die "could not apply $k"
  done <<< "$parsed"
  v=$(get AGENTOS_SSH_KEY)
  [ -z "$v" ] || chroot "$TARGET" /usr/local/bin/agentos-config add-ssh-key "$v" || die "could not add AGENTOS_SSH_KEY"
  while IFS= read -r k; do
    [ -n "$k" ] && valid_ssh_pubkey "$k" || continue
    chroot "$TARGET" /usr/local/bin/agentos-config add-ssh-key "$k" || die "could not add a GitHub key"
  done <<< "$ghkeys"
  v=$(get AGENTOS_PASSWORD_HASH)
  [ -z "$v" ] || usermod -R "$TARGET" -p "$v" agent || die "could not set the password"
  if [ -n "$(get AGENTOS_NET_ADDRESS)" ]; then
    network_file "$(get AGENTOS_NET_IFACE)" "$(get AGENTOS_NET_ADDRESS)" "$(get AGENTOS_NET_GATEWAY)" "$(get AGENTOS_NET_DNS)" \
      > "$TARGET/etc/systemd/network/10-agentos-static.network"
  fi
  touch "$TARGET/etc/cloud/cloud-init.disabled"
  sync
  cleanup_mounts; trap - EXIT ERR
  echo "AGENTOS INSTALL OK ($disk)"
}

auto() {
  local fat="" src b
  trap 'rm -f /run/agentos-install.env' EXIT  # holds secrets: never leave it behind, also on failure
  mkdir -p /run/agentos-data
  # Only the AGENTOS partition of the stick we booted from: another stick's agentos.env must not trigger an erase.
  b=$(boot_disk 2>/dev/null) || b=""
  if [ -n "$b" ] && [ -e "$DATA_DEV" ] && [ "$(lsblk -no PKNAME "$(readlink -f "$DATA_DEV")" | head -1)" = "$b" ] &&
     mount -o ro "$DATA_DEV" /run/agentos-data 2>/dev/null; then
    fat=/run/agentos-data/agentos.env
  fi
  src=$(autoinstall_source "$(cat /proc/cmdline)" "$fat") || die "invalid autoinstall settings on the kernel command line"
  # shellcheck disable=SC2086  # deliberate word splitting of "kind arg [sha]"; set -f: no globbing of '?'/'*' in the URL
  set -f; set -- $src; set +f
  case $1 in
    none) echo "AGENTOS-INSTALLER READY (interactive)"; return 0 ;;
    file) install -m 600 "$2" /run/agentos-install.env ;;
    url)
      (umask 077; curl -fsS --proto =https --tlsv1.2 --retry 5 --max-time 60 -o /run/agentos-install.env "$2") ||
        die "could not download the autoinstall file from $(url_host "$2")"
      if [ -n "${3:-}" ]; then
        echo "$3  /run/agentos-install.env" | sha256sum -c --quiet || die "autoinstall file does not match agentos.autoinstall_sha256"
      fi ;;
  esac
  # set -e + pipefail: a failed install exits here (the INSTALL FAILED line is already printed).
  install_from_env /run/agentos-install.env 2>&1 | tee -a "$LOG"
  local off
  off=$(parse_env /run/agentos-install.env | env_value AGENTOS_INSTALL_POWEROFF)
  rm -f /run/agentos-install.env
  if [ "$1" = file ]; then
    # Delete the settings (secrets) from the stick; left in place they would also reinstall on every boot.
    if mount -o remount,rw /run/agentos-data && shred -u "$fat" && sync -f /run/agentos-data; then
      echo "agentos.env deleted from the stick's AGENTOS partition."
    else
      echo "Could not delete agentos.env from the stick's AGENTOS partition: powering off instead of rebooting," \
           "so it does not install again. Remove the stick and delete agentos.env by hand (it may contain secrets)."
      off=1
    fi
  else
    echo "The kernel command line still holds the autoinstall URL: powering off." \
         "Remove the autoinstall boot entry/medium before powering on."
    off=1
  fi
  if [ "$off" = 1 ]; then systemctl poweroff; else systemctl reboot; fi
}

W() { whiptail --backtitle "AgentOS installer" "$@" 3>&1 1>&2 2>&3; }
ask() {  # ask <title> <prompt> <default> <validator|-> : repeat until valid or empty-allowed
  local v
  while true; do
    v=$(W --title "$1" --inputbox "$2" 12 72 "$3") || return 1
    [ "$4" = - ] || [ -z "$v" ] || "$4" "$v" && { printf '%s' "$v"; return 0; }
    W --msgbox "That value is not valid. Please try again." 8 50
  done
}

tui() {
  local env=/run/agentos-install.env disk name size model type why hidden="" items=() conf hn mode iface="" addr="" gw dns
  local pw pw2 hash="" key gh ts lan k v cm parts apikeys=""
  trap 'rm -f /run/agentos-install.env' EXIT  # = $env, holds secrets (literal: the trap may run after tui's locals are gone)
  trap 'exit 130' INT TERM HUP  # make an interrupted TUI run the EXIT trap
  # Offer only disks the engine would accept (same check_disk rules: not the stick, not in use, >= 32 GiB, unmounted).
  # Subshell: check_disk dies on a refused disk; that must not exit the TUI.
  while read -r name type size model; do
    [ "$type" = disk ] || continue
    if why=$( (check_disk "/dev/$name") 2>&1 ); then items+=("/dev/$name" "$size ${model//\\x20/ }")
    else hidden+="\n/dev/$name: ${why#INSTALL FAILED: }"; fi
  done < <(lsblk -dnro NAME,TYPE,SIZE,MODEL)
  [ ${#items[@]} -gt 0 ] || { W --msgbox "No installable disk found.$hidden" 16 76; return 1; }

  disk=$(W --title "Disk" --menu "Install AgentOS on which disk?\nThe whole disk will be ERASED." 18 72 8 "${items[@]}") || return 1
  parts=$(lsblk -lno NAME,FSTYPE,LABEL,SIZE "$disk" | head -8)
  conf=$(W --title "Erase $disk?" --inputbox "Current contents (ALL will be erased):\n$parts\n\nType the disk name ($(basename "$disk")) to confirm erasing it:" 20 76 "") || return 1
  [ "$conf" = "$(basename "$disk")" ] || { W --msgbox "Name did not match; nothing was changed." 8 60; return 1; }

  hn=$(ask Hostname "Hostname (lowercase letters, digits, dashes):" agentos valid_hostname) || return 1
  mode=$(W --title Network --menu "Network configuration" 12 60 2 dhcp "Automatic (DHCP)" static "Static IPv4") || return 1
  if [ "$mode" = static ]; then
    local nics=(); for k in /sys/class/net/*; do k=${k##*/}; [ "$k" = lo ] || nics+=("$k" ""); done
    iface=$(W --title Network --menu "Interface" 14 60 6 "${nics[@]}") || return 1
    addr=$(ask Network "Address with prefix, e.g. 192.168.1.50/24" "" valid_cidr) || return 1
    gw=$(ask Network "Gateway, e.g. 192.168.1.1" "" valid_ipv4) || return 1
    dns=$(W --title Network --inputbox "DNS servers, comma separated" 10 60 "1.1.1.1,9.9.9.9") || return 1
  fi
  pw=$(W --title Access --passwordbox "Password for user 'agent' (console + sudo). Empty = none, set later." 10 72) || return 1
  if [ -n "$pw" ]; then
    pw2=$(W --title Access --passwordbox "Repeat the password" 10 72) || return 1
    [ "$pw" = "$pw2" ] || { W --msgbox "Passwords did not match." 8 40; return 1; }
    hash=$(openssl passwd -6 -stdin <<< "$pw") && [ -n "$hash" ] || { W --msgbox "Could not hash the password." 8 40; return 1; }
    pw="set"  # drop the plaintext; only "is set" is needed from here on
  fi
  key=$(ask Access "SSH public key to allow (optional, paste one line):" "" valid_ssh_pubkey) || return 1
  gh=$(W --title Access --inputbox "Also import SSH keys from GitHub user (optional):" 10 72 "") || return 1
  ts=$(W --title Tailscale --passwordbox "Tailscale auth key (optional). Use a single-use, pre-approved key tagged tag:agentos." 10 72) || return 1
  lan=0
  [ -n "$ts" ] || ! W --title "SSH from LAN" --yesno "No Tailscale key. Allow SSH (key-only) from your local network?" 8 70 || lan=1
  cm=$(W --title Console --menu "Local console after install" 12 70 2 headless "Status + login prompt" terminal "Full-screen terminal after login") || return 1
  for k in ANTHROPIC_API_KEY OPENAI_API_KEY GROK_CODE_XAI_API_KEY CLAUDE_CODE_OAUTH_TOKEN; do
    v=$(W --title "API keys (optional)" --passwordbox "$k (empty = skip; can be set later with agentos-config)" 10 72) || return 1
    [ -z "$v" ] || apikeys+="$k=$v"$'\n'
  done
  # The summary is the last question; nothing is written before it is confirmed. Show only whether a secret is set.
  local s_pw=${pw:+set} s_key=${key:+yes} s_ts=${ts:+yes}
  W --title Summary --yesno "Disk:      $disk (ERASED)\nHostname:  ${hn:-default}\nNetwork:   $mode${iface:+ $iface $addr}\nPassword:  ${s_pw:-none}\nSSH key:   ${s_key:-no}${gh:+ + GitHub $gh}\nTailscale: ${s_ts:-no}\nLAN SSH:   $lan\n\nInstall now?" 18 72 || return 1

  (umask 077
   {
     printf 'AGENTOS_INSTALL_DISK=%s\nAGENTOS_HOSTNAME=%s\nAGENTOS_CONSOLE=%s\nAGENTOS_LAN_SSH=%s\n' "$disk" "$hn" "$cm" "$lan"
     [ -z "$hash" ] || printf 'AGENTOS_PASSWORD_HASH=%s\n' "$hash"
     [ -z "$key" ] || printf 'AGENTOS_SSH_KEY=%s\n' "$key"
     [ -z "$gh" ] || printf 'AGENTOS_GITHUB_USER=%s\n' "$gh"
     [ -z "$ts" ] || printf 'TS_AUTHKEY=%s\n' "$ts"
     [ "$mode" != static ] || printf 'AGENTOS_NET_IFACE=%s\nAGENTOS_NET_ADDRESS=%s\nAGENTOS_NET_GATEWAY=%s\nAGENTOS_NET_DNS=%s\n' "$iface" "$addr" "$gw" "$dns"
     printf '%s' "$apikeys"
   } > "$env")
  clear
  # A separate process, not (install_from_env ...): inside an if/||/&& condition bash disables errexit AND the
  # ERR trap, also in subshells, so unchecked failures in the engine would be ignored. A fresh process restores both.
  if AGENTOS_DD_STATUS=progress "$0" --env "$env" 2>&1 | tee -a "$LOG"; then
    rm -f "$env"
    W --msgbox "AgentOS is installed.\n\nRemove the USB stick, then press Enter to reboot." 10 60
    systemctl reboot
  else
    rm -f "$env"
    W --msgbox "Installation failed:\n\n$(grep 'INSTALL FAILED' "$LOG" | tail -1)\n\nFull log: $LOG (Alt+F2 for a shell)." 14 72
    return 1
  fi
}

case "${1:-}" in
  --auto) auto ;;
  --env)  install_from_env "${2:?usage: agentos-install --env FILE}" ;;
  --tui)  tui || true ;;
  *)      echo "usage: agentos-install --auto | --tui | --env FILE" >&2; exit 2 ;;
esac
