#!/bin/bash
# Runs inside the finished image tree, after RemoveFiles. Fails the build on leaked per-install state.
set -euo pipefail

chmod 0440 /etc/sudoers.d/agent
chown -R agent:agent /home/agent/.config/xfce4

# dpkg's path-exclude for /usr/share/locale/* (mkosi.skeleton/etc/dpkg/dpkg.cfg.d/01-agentos-nodoc)
# does not take effect for every package that ships locale catalogs (verified: man/doc/info
# excludes from the same file DO work; locale does not, even in isolation with plain dpkg
# --unpack). Locale=C.UTF-8 means no translation catalogs are needed, so remove them directly.
rm -rf /usr/share/locale/*

fail() { echo "IMAGE INVARIANT VIOLATED: $*" >&2; exit 1; }

dpkg-query -W -f '${Package} ${Version}\n' > /var/lib/agentos-manifest.txt

# --version runs write CLI state (~/.claude.json with machine/user IDs, ~/.codex/tmp, ...), so
# run them with a throwaway HOME; binaries still resolve through the agent's real PATH.
AGENT_PATH=$(runuser -u agent -- bash -lc 'echo "$PATH"')
vhome=$(runuser -u agent -- mktemp -d)
{
  echo "# agent CLIs"
  for c in claude codex opencode grok; do
    p=$(runuser -u agent -- env PATH="$AGENT_PATH" bash -c "readlink -f \"\$(command -v $c)\"")
    v=$(runuser -u agent -- env HOME="$vhome" PATH="$AGENT_PATH" bash -c "set -o pipefail; $c --version 2>/dev/null | head -1")
    [ -n "$v" ] || fail "no --version output for $c"
    echo "$c ${v// /_} $(sha256sum "$p" | cut -d' ' -f1)"
  done
} >> /var/lib/agentos-manifest.txt
{ echo "# agentos-computer python"; /usr/local/lib/agentos/venv/bin/pip freeze --disable-pip-version-check; } >> /var/lib/agentos-manifest.txt
{ echo "# agentos-web npm"; node -e '
    const d = "/usr/local/lib/agentos/web/server";
    for (const n of Object.keys(require(d + "/package.json").dependencies))
      console.log(n + "@" + require(d + "/node_modules/" + n + "/package.json").version);'; } >> /var/lib/agentos-manifest.txt
rm -rf "$vhome"

# Invariants last, after everything above that could have written state.
A=/home/agent
if compgen -G '/etc/ssh/ssh_host_*' >/dev/null; then fail "SSH host keys baked into image"; fi
if [ -s /etc/machine-id ] && [ "$(cat /etc/machine-id)" != uninitialized ]; then fail "machine-id baked into image"; fi
if [ -n "$(ls -A /var/lib/tailscale 2>/dev/null)" ]; then fail "tailscale state baked into image"; fi
# Spec: no ~agent/.claude* at all (we deliberately ship no claude settings yet).
if compgen -G "$A/.claude*" >/dev/null; then fail "claude state baked into image: $(echo "$A"/.claude*)"; fi
for f in "$A/.codex/auth.json" \
         "$A/.local/share/opencode/auth.json" "$A/.local/share/opencode/mcp-auth.json" \
         "$A/.grok/auth.json" "$A/.grok/mcp_credentials.json"; do
  if [ -e "$f" ]; then fail "CLI auth state baked into image: $f"; fi
done
if [ -e /etc/agentos/mcp-token ]; then fail "mcp-token baked into image (first-boot-only secret)"; fi

W=/usr/local/lib/agentos/web
for f in "$W/server/dist/main.js" "$W/ui/index.html" "$W/server/node_modules/node-pty/build/Release/pty.node"; do
  if [ ! -f "$f" ]; then fail "web UI build output missing: $f"; fi
done
if [ -e "$W/server/node_modules/typescript" ] || [ -e "$W/server/node_modules/vitest" ]; then fail "web UI dev dependencies shipped"; fi

echo "image invariants OK"
