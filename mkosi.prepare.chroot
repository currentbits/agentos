#!/bin/bash
# Runs inside the image after apt packages are installed. Has network access.
set -euo pipefail
[ "${1:-final}" = final ] || exit 0

id agent >/dev/null 2>&1 || useradd --create-home --uid 1000 --shell /bin/bash --groups sudo,docker agent

AGENT_PATH=/home/agent/.local/bin:/home/agent/.cargo/bin:/home/agent/.bun/bin:/home/agent/.opencode/bin:/home/agent/.grok/bin:/usr/local/bin:/usr/bin:/bin
as_agent() {
  runuser -u agent -- env -i HOME=/home/agent USER=agent PATH="$AGENT_PATH" \
    SHELL=/bin/bash TERM=dumb bash -euo pipefail -c "$1"
}

# Rust: minimal profile (no offline docs) + clippy, rustfmt
as_agent 'curl -fsSL https://sh.rustup.rs | sh -s -- -y --no-modify-path --profile minimal -c clippy,rustfmt'
# Bun
as_agent 'curl -fsSL https://bun.sh/install | bash'
# npm global prefix inside ~/.local so `npm i -g` never needs root
as_agent 'npm config set prefix "$HOME/.local"'
# Playwright + its Chromium (browser in ~/.cache/ms-playwright); OS deps via apt as root
as_agent 'npm install -g playwright'
/home/agent/.local/bin/playwright install-deps chromium
as_agent 'playwright install chromium'

# Agent CLIs, each via its official installer, into the agent's home so self-updates work without root.
as_agent 'curl -fsSL https://claude.ai/install.sh | bash'
as_agent 'npm install -g @openai/codex'
as_agent 'curl -fsSL https://opencode.ai/install | bash'
as_agent 'curl -fsSL https://x.ai/cli/install.sh | bash'

# Installers may edit ~/.bashrc / ~/.profile to add PATH lines; /etc/profile.d/agentos.sh owns PATH.
cp /etc/skel/.bashrc /home/agent/.bashrc
cp /etc/skel/.profile /home/agent/.profile
chown agent:agent /home/agent/.bashrc /home/agent/.profile

for c in claude codex opencode grok; do
  as_agent "command -v $c >/dev/null" || { echo "agent CLI '$c' not on PATH after install" >&2; exit 1; }
done

# XFCE: ship the default panel config so the first start shows no "Panel: use default config?" dialog.
install -d -o agent -g agent /home/agent/.config/xfce4/xfconf/xfce-perchannel-xml
install -o agent -g agent -m 644 /etc/xdg/xfce4/panel/default.xml \
  /home/agent/.config/xfce4/xfconf/xfce-perchannel-xml/xfce4-panel.xml

# agentos-computer and agentos-ci deps, isolated from the system and the agent's own Python.
python3 -m venv /usr/local/lib/agentos/venv
/usr/local/lib/agentos/venv/bin/pip install --no-cache-dir --disable-pip-version-check 'mcp>=1.28,<2' 'pillow>=10' 'pyyaml>=6,<7'

# act runs .github/workflows for agentos-ci. Pinned by version and sha256 (the release's
# checksums.txt); Docker pulls its runner images on first use, they are never baked in.
ACT_VERSION=0.2.89
ACT_SHA256=0191d6f1f3b716b5c55820032605d05fc3c1cdbf581ebeff655019e5dd1524c0
at=$(mktemp -d)
curl -fsSL -o "$at/act.tgz" "https://github.com/nektos/act/releases/download/v$ACT_VERSION/act_Linux_x86_64.tar.gz"
echo "$ACT_SHA256  $at/act.tgz" | sha256sum -c --quiet -
tar -xzf "$at/act.tgz" -C "$at" act
install -m 755 "$at/act" /usr/local/bin/act
rm -rf "$at"

# The Mac-side Solenta bridge (Mode B), served for download by the web UI's Solenta card.
install -D -m 755 "$SRCDIR/tools/solenta-bridge" /usr/local/share/agentos/solenta-bridge

# AgentOS web UI (web/): built here because prepare scripts have network access. Only the build
# output and production node_modules land in /usr/local/lib/agentos/web; node-pty compiles against
# this image's Node with node-gyp (build-essential, python3). HOME points into the scratch dir so the
# npm and node-gyp caches never land in /root. Host node_modules/dist are excluded: a macOS checkout
# must not leak darwin binaries into the image.
W=/usr/local/lib/agentos/web
wb=$(mktemp -d)
tar -C "$SRCDIR/web" --exclude=node_modules --exclude=dist -cf - . | tar -C "$wb" -xf -
# shellcheck disable=SC2016 # $HOME expands in the inner shell, which runs with HOME=$wb
# One command per line: set -e ignores a failure anywhere in an && chain except its last command.
HOME=$wb bash -euo pipefail -c '
  cd "$HOME/ui"
  npm ci --no-audit --no-fund
  npm run build
  cd "$HOME/server"
  npm ci --no-audit --no-fund
  npm run build
  npm prune --omit=dev --no-audit --no-fund
  # node-pty also ships Windows/macOS prebuilds and its C++ sources; Linux loads build/Release only.
  rm -rf node_modules/node-pty/prebuilds node_modules/node-pty/third_party node_modules/node-pty/deps node_modules/node-pty/src'
rm -rf "$W"
install -d "$W/server"
cp -a "$wb/server/dist" "$wb/server/node_modules" "$wb/server/package.json" "$W/server/"
cp -a "$wb/ui/dist" "$W/ui"
rm -rf "$wb"
